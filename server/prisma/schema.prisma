datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client-js"
}

model Utilisateur {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String
  nom          String?
  prenom       String?
  role         String         // "ADMIN" | "HR"
  createdAt    DateTime       @default(now())
  missions     OrdreMission[]
}

model Employe {
  id               Int              @id @default(autoincrement())
  mle              String?          @unique
  nom              String
  prenom           String
  fonction         String?
  hotelAffectation String           @default("Direction générale")
  actif            Boolean          @default(true)
  missions         OrdreMission[]
  accompagnements  Accompagnateur[]
}

model Etablissement {
  id        Int         @id @default(autoincrement())
  code      String      @unique
  nom       String
  ville     String
  adresse   String?
  actif     Boolean     @default(true)
  createdAt DateTime    @default(now())
  chauffeurs Chauffeur[]
}

model Chauffeur {
  id                  Int            @id @default(autoincrement())
  mle                 String?        @unique
  nom                 String
  prenom              String
  telephone           String?
  disponible          Boolean        @default(true)
  vehiculeParDefautId Int?           @unique
  vehiculeParDefaut   Vehicule?      @relation("ChauffeurVehiculeDefaut", fields: [vehiculeParDefautId], references: [id])
  etablissementId     Int?
  etablissement       Etablissement? @relation(fields: [etablissementId], references: [id], onDelete: SetNull)
  missions            OrdreMission[]
}

model Vehicule {
  id                Int            @id @default(autoincrement())
  immatriculation   String         @unique
  marque            String
  modele            String
  type              String         // "Voiture" | "Utilitaire" | "Aucun"
  disponible        Boolean        @default(true)
  chauffeurParDefaut Chauffeur?    @relation("ChauffeurVehiculeDefaut")
  missions          OrdreMission[]
}

model ObjetMission {
  id       Int            @id @default(autoincrement())
  libelle  String         @unique
  actif    Boolean        @default(true)
  missions OrdreMission[]
}

model Destination {
  id                  Int                  @id @default(autoincrement())
  nom                 String               @unique
  ville               String
  missions            OrdreMission[]
  destinationsMission DestinationMission[]
}

model OrdreMission {
  id                 Int                  @id @default(autoincrement())
  reference          String               @unique
  employeId          Int?
  employe            Employe?             @relation(fields: [employeId], references: [id], onDelete: SetNull)
  destinationId      Int
  destination        Destination          @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  chauffeurId        Int
  chauffeur          Chauffeur            @relation(fields: [chauffeurId], references: [id], onDelete: Restrict)
  vehiculeId         Int
  vehicule           Vehicule             @relation(fields: [vehiculeId], references: [id], onDelete: Restrict)
  objetMissionId     Int
  objetMission       ObjetMission         @relation(fields: [objetMissionId], references: [id], onDelete: Restrict)
  creeParId          Int
  creePar            Utilisateur          @relation(fields: [creeParId], references: [id], onDelete: Restrict)

  dateDebut          DateTime
  dateFin            DateTime?
  heureDepart        String               // "HH:mm"
  heureRetour        String?              // "HH:mm"

  departReel         DateTime?
  retourReel         DateTime?

  statut             String               // "PLANIFIE" | "EN_COURS" | "TERMINE" | "ANNULE"
  itineraire         String?
  fraisParticipation Float?               @default(0)
  fraisMission       Float?               @default(0)
  notes              String?
  createdAt          DateTime             @default(now())

  accompagnateurs    Accompagnateur[]
  destinationsMission DestinationMission[]
}

model Accompagnateur {
  id             Int          @id @default(autoincrement())
  ordreMissionId Int
  ordreMission   OrdreMission @relation(fields: [ordreMissionId], references: [id], onDelete: Cascade)
  employeId      Int
  employe        Employe      @relation(fields: [employeId], references: [id], onDelete: Restrict)

  @@unique([ordreMissionId, employeId])
}

model DestinationMission {
  id             Int          @id @default(autoincrement())
  ordreMissionId Int
  ordreMission   OrdreMission @relation(fields: [ordreMissionId], references: [id], onDelete: Cascade)
  destinationId  Int
  destination    Destination  @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@unique([ordreMissionId, destinationId])
}
